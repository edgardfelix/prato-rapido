# Copy this file to ".env" and fill in your values.

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
# Leave it empty to run in DEMO mode with sample recipes.
GEMINI_API_KEY=

# Models (Gemini API). Leave empty to use the defaults below.
# Retired names such as gemini-1.5-flash, gemini-1.5-pro and gemini-2.0-flash-exp return 404.
# The server logs at startup which configured models exist for your key.
GEMINI_MODEL=gemini-3.8-flash
# Tried in this order when the main model fails (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Reasoning depth: minimal | low | medium | high (lower = faster answers)
GEMINI_THINKING_LEVEL=low

# Timeout for each model attempt, in milliseconds
GEMINI_TIMEOUT_MS=25000

# API port (in development Vite proxies /api to this port)
PORT=3001

# Set to true to force demo mode even when a key is configured
DEMO_MODE=false

# Comma-separated list of allowed browser origins (enables CORS for them).
# Leave empty when the API and the web app share the same origin.
ALLOWED_ORIGINS=

# Set to true when running behind a reverse proxy (Render, Railway, Fly, Nginx)
TRUST_PROXY=false

# Max AI requests per IP per minute (applies to each endpoint)
RATE_LIMIT_PER_MINUTE=10

# Food photos: the API proxies and caches Pollinations images (see README).
# Without a key the free endpoint image.pollinations.ai is used, which allows
# 1 image every 45 seconds per server IP (requests are queued automatically).
# Optional key from https://enter.pollinations.ai/keys for higher limits.
# It stays on the server, so a secret sk_ key is safe here.
POLLINATIONS_API_KEY=

# Secret used to sign image URLs. Optional: derived from GEMINI_API_KEY when empty.
# Set it explicitly to keep saved image links valid if you rotate the Gemini key.
IMAGE_SIGNING_SECRET=

# --- Paid access: Cakto webhook + Upstash Redis (see README, "Acesso pago") ---
# Upstash Redis "REST URL" and "REST Token" (console.upstash.com → your database → REST API).
# The paywall turns on automatically when both are set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Buyers registered by the landing page (lp-pratorapido): Cakto calls its webhook,
# which writes "pratorapido:lp:grant:<hmac of the e-mail>" to the same Upstash database.
# Use the SAME value as ACCESS_TOKEN_SECRET in the lp-pratorapido project (32+ chars);
# without it the app cannot find those buyers. LP_REDIS_PREFIX = REDIS_PREFIX there.
LP_ACCESS_TOKEN_SECRET=
LP_REDIS_PREFIX=pratorapido:lp:

# Optional, this app's own Cakto webhook (POST /api/webhook/cakto): the secret Cakto
# returns when you create a webhook for it. Without it that webhook refuses every delivery.
CAKTO_WEBHOOK_SECRET=

# Your Cakto checkout link, used by the "Comprar Acesso" button (must be https).
CAKTO_CHECKOUT_URL=

# Optional: only these Cakto product ids, short ids or offer ids grant access
# (comma-separated). Leave empty if this webhook only sends Prato Rápido sales.
CAKTO_PRODUCT_IDS=

# Optional: price shown on the button, days an activation lasts before it is
# renewed silently, and PAYWALL_ENABLED=false to keep the app open even with Upstash set.
ACCESS_PRICE_LABEL=R$ 21,90
ACCESS_TOKEN_TTL_DAYS=90
PAYWALL_ENABLED=
